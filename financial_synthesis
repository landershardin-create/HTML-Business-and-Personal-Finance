// storage/financial_synthesis.js

export const financial_synthesis = {
    records: [],

    add(entry) {
        this.records.push({
            entity_id: entry.entity_id,
            liquidity_score: entry.liquidity_score,
            leverage_risk: entry.leverage_risk,
            profitability_strength: entry.profitability_strength,
            cashflow_stability: entry.cashflow_stability,
            timestamp: Date.now()
        });
    },

    latest(entity_id) {
        return this.records
            .filter(r => r.entity_id === entity_id)
            .sort((a, b) => b.timestamp - a.timestamp)[0] || null;
    }
};